2026-06-10T00:27:19.5604709Z ##[group]Run set -e
set -e
echo "=== Applying patches with fuzzy matching ==="
for patch in patches/*.patch; do
  if [ -f "$patch" ]; then
    echo "Applying: $patch"
    
    # Try strict patch first
    if git apply --check "$patch" 2>/dev/null; then
      echo "✓ Strict patch check passed"
      git apply "$patch"
      echo "✓ Applied: $patch (strict mode)"
    else
      echo "⚠ Strict patch failed, trying fuzzy matching..."
      
      # Try with fuzz factor
      if patch -p1 --dry-run <"$patch" 2>/dev/null; then
        patch -p1 <"$patch"
        echo "✓ Applied: $patch (fuzzy mode)"
      else
        echo "ERROR: Could not apply patch $patch with any method"
        echo "Showing patch context:"
        head -50 "$patch"
        exit 1
      fi
    fi
  fi
done
echo ""
echo "=== All patches applied successfully ==="